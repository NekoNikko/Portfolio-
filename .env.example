# Public portfolio environment (no secrets — server-side only)
#
# Copy to .env.local to override. Never commit .env.local.
# All values have working defaults, so the app runs on localhost with no env.

# Canonical public base URL (used for canonical links + sitemap).
# Set to your domain when deployed behind Cloudflare Tunnel, e.g.
# PUBLIC_BASE_URL=https://portfolio.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Port the local server listens on (default 3000).
PORT=3000

# Admin area password (server-side only; NEVER commit a real value).
# Required for /admin to function. Keep it long and unique.
ADMIN_PASSWORD=change-me-to-a-long-random-password